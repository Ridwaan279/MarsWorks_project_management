# ---------------------------------------------------------------------------
# The application's connection. On Supabase use the TRANSACTION pooler
# (port 6543): it is built for serverless, where every concurrent instance
# opens its own pool, and tolerates far more clients than session mode.
#   Project Settings > Database > Connection string > Transaction pooler
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres"

# ---------------------------------------------------------------------------
# Migrations and seeding only. These need a session-mode connection, because
# DDL and Prisma's advisory locks do not survive a transaction pooler.
#   Project Settings > Database > Connection string > Session pooler (5432)
#
# Needed where you run `prisma db push` or `npm run db:seed`, and on Vercel
# (Production): there, each deploy uses it to apply schema changes before
# the new code goes live. See scripts/sync-schema.mjs.
# ---------------------------------------------------------------------------
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Optional. Connections one process may hold. Defaults to 3 on Vercel and 5
# locally; raise it only if you know the pooler has room.
# DATABASE_POOL_MAX=3

# ---------------------------------------------------------------------------
# Google Sheets sync. See docs/google-sheets-sync.md.
#
# A long random string shared with the Apps Script in the sheet. Without it
# the sync endpoint refuses every call.
# SHEETS_SYNC_SECRET=""
#
# Optional: the sheet script's web app URL (ends in /exec). With it, a change
# on the website reaches the sheet within seconds; without it, at the next
# five-minute check.
# SHEETS_WEBAPP_URL=""
# ---------------------------------------------------------------------------
