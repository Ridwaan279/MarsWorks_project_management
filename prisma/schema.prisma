// MarsWorks Mission Control — canonical schema.
// This database is the single source of truth. GitHub Projects and Google
// Sheets are synchronised surfaces that read from and write back to it.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A MarsWorks sub-team (Chassis, Avionics, Science, ...).
model Team {
  id          String   @id @default(cuid())
  key         String   @unique // short prefix used in task keys, e.g. "CHS"
  name        String
  description String?
  colour      String   @default("#6366f1")
  position    Int      @default(0)
  /// How this sub-team prefers to see its work. Both views render the same
  /// rows; this only decides which one opens by default.
  defaultView TeamView @default(BOARD)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     Member[]
  tasks       Task[]
  workstreams Workstream[]
}

enum TeamView {
  BOARD
  TIMELINE
}

/// A group of related tasks within a sub-team -- Mechanical's WBS headings
/// ("3.0 Pivot Wheel Project"), Electrical's project areas. Eight teams of
/// flat tasks is unreadable; this is the grouping every existing planner
/// already has in some form.
model Workstream {
  id        String   @id @default(cuid())
  teamId    String
  /// Work-breakdown code as the team writes it, e.g. "3.0". Optional because
  /// not every team numbers its workstreams.
  code      String?
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([teamId, name])
  @@index([teamId])
}

/// A person on the project. Identity is anchored on their GitHub login so the
/// same human maps cleanly across the app, GitHub Projects and the sheets.
model Member {
  id          String   @id @default(cuid())
  name        String
  email       String?  @unique
  githubLogin String?  @unique
  avatarUrl   String?
  teamId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team          Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedTasks Task[] @relation("TaskAssignee")

  @@index([teamId])
}

/// A dated checkpoint the whole project is measured against (design freeze,
/// field trial, competition day).
model Milestone {
  id          String   @id @default(cuid())
  name        String
  description String?
  targetDate  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Engineering lifecycle phase, adopted from the Electrical team's tracker.
/// ORDER matters more than it looks: procurement lead time is the single
/// largest source of slip on a hardware project, and no other sub-team was
/// tracking it at all.
enum ProjectStage {
  INVESTIGATION
  DESIGN
  PROTOTYPE
  ORDER
  CONSTRUCTION
  TESTING
  IMPROVEMENT
  DOCUMENTATION
}

model Task {
  id          String       @id @default(cuid())
  key         String       @unique // e.g. "CHS-12"
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)

  teamId       String
  assigneeId   String?
  milestoneId  String?
  workstreamId String?

  stage ProjectStage?

  /// Free-text owner as the source planner wrote it ("Owen & Jack", "Team",
  /// "Sub-Team Leads"). Real planners do not have one person per row, and
  /// dropping that on import would lose information the team relies on.
  ownerLabel String?

  /// What the team committed to. Every existing planner is built on hand-set
  /// start and end dates, so these are first-class rather than derived.
  plannedStart DateTime?
  plannedEnd   DateTime?

  /// What actually happened. Needed to draw completed work where it really
  /// occurred, and to measure estimate quality later.
  actualStart DateTime?
  actualEnd   DateTime?

  /// Free-text column carried over from the master sheet.
  notes String?

  /// Raised by hand to mean "someone look at this". Deliberately separate from
  /// priority: priority is how important the work is, a flag is a request for
  /// attention now, and a task can be low priority and still need eyes on it.
  flagged Boolean @default(false)

  /// Earliest the work can begin regardless of predecessors (part delivery,
  /// lab access). The scheduler treats this as a hard lower bound.
  earliestStart DateTime?
  /// Planned effort in calendar days. Drives the critical-path calculation.
  estimateDays  Int       @default(1)
  /// Self-reported completion, 0-100.
  progress      Int       @default(0)

  /// Ordering within its Kanban column. Sparse (gaps of 1000) so a drag only
  /// rewrites the row that moved.
  boardOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee  Member?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  milestone  Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  workstream Workstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)

  links         TaskLink[]
  subtasks      Subtask[]
  externalLinks ExternalLink[]

  /// Edges where this task must finish before another can start.
  blocks    TaskDependency[] @relation("Predecessor")
  /// Edges where another task must finish before this one can start.
  blockedBy TaskDependency[] @relation("Successor")

  @@index([teamId])
  @@index([assigneeId])
  @@index([status])
  @@index([milestoneId])
  @@index([flagged])
  @@index([workstreamId])
}

/// A checklist item under a task, as the Electrical tracker uses them. Not a
/// task in its own right: no dates, no dependencies, no place on the board.
model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// A reference attached to a task: CAD file, datasheet, PR, test report.
model TaskLink {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  label     String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// Finish-to-start dependency edge. The predecessor must complete before the
/// successor may begin. Cross-team edges are what make delay impact visible.
model TaskDependency {
  id            String   @id @default(cuid())
  predecessorId String
  successorId   String
  /// Mandatory gap in days between predecessor finish and successor start
  /// (curing, shipping, procurement).
  lagDays       Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())

  predecessor Task @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
}

enum ExternalSystem {
  GITHUB
  SHEETS
}

/// Maps a canonical task to its mirror in an external system. `contentHash`
/// records what we last wrote out, so the webhook echo of our own write can be
/// recognised and dropped instead of looping.
model ExternalLink {
  id           String         @id @default(cuid())
  taskId       String
  system       ExternalSystem
  externalId   String
  externalUrl  String?
  contentHash  String?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([system, externalId])
  @@index([taskId])
}
